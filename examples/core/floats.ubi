export fn finite() -> float { 1.5 }
export fn negativeZero() -> float { -0.0 }
export fn positiveInfinity() -> float { 1.0 / 0.0 }
export fn negativeInfinity() -> float { 1.0 / -0.0 }
export fn notANumber() -> float { 0.0 / 0.0 }
export fn rounding() -> float { 9007199254740992.0 + 1.0 }
export fn underflow() -> float { 1e-400 }
export fn comparisons() -> bool {
  let nan = 0.0 / 0.0;
  (nan != nan) && !(nan == nan) && !(nan < 1.0) && (0.0 == -0.0)
}
