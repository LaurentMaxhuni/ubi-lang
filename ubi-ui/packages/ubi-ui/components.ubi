export fn timeline<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { timelineComponent(key, props, children) }
export fn table<M>(key: string, label: string, columns: List<TableColumn>, rows: List<TableRow>, sort: M, props: List<Prop<M>>) -> View<M> { tableComponent(key, label, columns, rows, sort, props) }
export fn spotlightCard<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { spotlightCardComponent(key, props, children) }
export fn tiltCard<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { tiltCardComponent(key, props, children) }
export fn cardStack<M>(key: string, label: string, selected: int, previous: M, next: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { cardStackComponent(key, label, selected, previous, next, props, children) }
export fn carousel<M>(key: string, label: string, selected: int, previous: M, next: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { carouselComponent(key, label, selected, previous, next, props, children) }
