import { View, Kind, Prop, node } from "../core.ubi";

export fn checkboxComponent<M>(key: string, content: string, checked: bool, message: M, props: List<Prop<M>>) -> View<M> {
    node(key, Kind.Checkbox, append(append(append(append(props, Prop.Content(content)), Prop.Label(content)), Prop.Checked(checked)), Prop.Toggle(message)))
}

export fn checkbox<M>(key: string, content: string, checked: bool, message: M, props: List<Prop<M>>) -> View<M> { checkboxComponent(key, content, checked, message, props) }
