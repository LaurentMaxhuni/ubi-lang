import { View, Kind, Prop, Effect, group } from "../core.ubi";

export fn spotlightCardComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.EffectSurface, append(props, Prop.Effect(Effect.SpotlightCard)), children)
}
export fn spotlightCard<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { spotlightCardComponent(key, props, children) }
