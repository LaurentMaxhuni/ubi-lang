import { View, Kind, Prop, node } from "../core.ubi";

export fn passwordInputComponent<M>(key: string, label: string, value: string, message: M, props: List<Prop<M>>) -> View<M> {
    node(key, Kind.PasswordInput, append(append(append(props, Prop.Label(label)), Prop.Value(value)), Prop.Input(message)))
}

export fn passwordInput<M>(key: string, label: string, value: string, message: M, props: List<Prop<M>>) -> View<M> { passwordInputComponent(key, label, value, message, props) }
