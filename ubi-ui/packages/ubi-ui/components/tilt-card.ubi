import { View, Kind, Prop, Effect, group } from "../core.ubi";

export fn tiltCardComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.EffectSurface, append(props, Prop.Effect(Effect.TiltCard)), children)
}
export fn tiltCard<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { tiltCardComponent(key, props, children) }
