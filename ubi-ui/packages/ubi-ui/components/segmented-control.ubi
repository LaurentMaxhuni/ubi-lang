import { View, Kind, Prop, Choice, node, group } from "../core.ubi";

export fn segmentedControlComponent<M>(key: string, label: string, choices: List<Choice>, selected: string, message: M, props: List<Prop<M>>) -> View<M> {
    let mut items: List<View<M>> = [];
    for (choice in choices) { items = append(items, node(key + "-" + choice.value, Kind.ToggleItem, [Prop.Content(choice.label), Prop.Label(choice.label), Prop.Selected(selected == choice.value), Prop.Option(choice.value), Prop.Group(key), Prop.Disabled(choice.disabled), Prop.Change(message)])); }
    group(key, Kind.Row, append(append(props, Prop.Label(label)), Prop.Role("toolbar")), items)
}

export fn segmentedControl<M>(key: string, label: string, choices: List<Choice>, selected: string, message: M, props: List<Prop<M>>) -> View<M> { segmentedControlComponent(key, label, choices, selected, message, props) }
