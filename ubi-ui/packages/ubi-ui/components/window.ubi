import { View, Kind, Prop, group } from "../core.ubi";

export fn windowComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.Window, props, children)
}

export fn window<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { windowComponent(key, props, children) }
