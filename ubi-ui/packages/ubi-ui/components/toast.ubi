import { View, Prop, OverlayKind } from "../core.ubi";
import { overlayComponent } from "./overlay.ubi";

export fn toastComponent<M>(key: string, label: string, open: bool, dismiss: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    overlayComponent(key, label, OverlayKind.Toast, open, dismiss, props, children)
}
export fn toast<M>(key: string, label: string, open: bool, dismiss: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { toastComponent(key, label, open, dismiss, props, children) }
