import { View, Kind, Prop, group } from "../core.ubi";

export fn rowComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.Row, props, children)
}

export fn row<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { rowComponent(key, props, children) }
