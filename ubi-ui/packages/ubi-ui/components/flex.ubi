import { View, Kind, Prop, group } from "../core.ubi";

export fn flexComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.Flex, props, children)
}

export fn flex<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { flexComponent(key, props, children) }
