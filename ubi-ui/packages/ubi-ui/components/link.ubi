import { View, Kind, Prop, node } from "../core.ubi";

export fn linkComponent<M>(key: string, content: string, message: M, props: List<Prop<M>>) -> View<M> {
    node(key, Kind.Link, append(append(props, Prop.Content(content)), Prop.Activate(message)))
}

export fn link<M>(key: string, content: string, message: M, props: List<Prop<M>>) -> View<M> { linkComponent(key, content, message, props) }
