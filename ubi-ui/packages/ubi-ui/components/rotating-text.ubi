import { View, Kind, Prop, Effect, node, group } from "../core.ubi";

export fn rotatingTextComponent<M>(key: string, phrases: List<string>, selected: int, advance: M, paused: bool, toggle: M, props: List<Prop<M>>) -> View<M> {
    let mut phraseViews: List<View<M>> = [];
    let mut index = 0;
    for (phrase in phrases) {
        phraseViews = append(phraseViews, node(key + "-phrase-" + toString(index), Kind.Text, [Prop.Label(phrase), Prop.Content(phrase), Prop.Option(toString(index)), Prop.Selected(index == selected)]));
        index = index + 1;
    }
    let surface = group(key + "-phrases", Kind.EffectSurface, append(append(append(append(props, Prop.Effect(Effect.RotatingText)), Prop.Index(selected)), Prop.Advance(advance)), Prop.Paused(paused)), phraseViews);
    let pause: View<M> = node(key + "-pause", Kind.Button, [Prop.Label(if (paused) { "Resume phrase rotation" } else { "Pause phrase rotation" }), Prop.Content(if (paused) { "Resume" } else { "Pause" }), Prop.Pressed(paused), Prop.Activate(toggle)]);
    group(key, Kind.Column, [], [surface, pause])
}
export fn rotatingText<M>(key: string, phrases: List<string>, selected: int, advance: M, paused: bool, toggle: M, props: List<Prop<M>>) -> View<M> { rotatingTextComponent(key, phrases, selected, advance, paused, toggle, props) }
