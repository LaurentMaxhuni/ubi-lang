import { View, Kind, Prop, group } from "../core.ubi";

export fn breadcrumbComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.Row, append(append(props, Prop.Label("Breadcrumb")), Prop.Role("navigation")), children)
}

export fn breadcrumb<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { breadcrumbComponent(key, props, children) }
