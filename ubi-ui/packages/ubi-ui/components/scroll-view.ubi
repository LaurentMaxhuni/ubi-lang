import { View, Kind, Prop, group } from "../core.ubi";

export fn scrollViewComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.ScrollView, props, children)
}

export fn scrollView<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { scrollViewComponent(key, props, children) }
