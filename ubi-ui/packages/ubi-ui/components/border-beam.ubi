import { View, Kind, Prop, Effect, group } from "../core.ubi";

export fn borderBeamComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.EffectSurface, append(props, Prop.Effect(Effect.BorderBeam)), children)
}
export fn borderBeam<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { borderBeamComponent(key, props, children) }
