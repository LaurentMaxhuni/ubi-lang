import { View, Kind, Prop, node, group } from "../core.ubi";

export fn collapsibleComponent<M>(key: string, title: string, open: bool, message: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    let trigger: View<M> = node(key + "-trigger", Kind.Toggle, [Prop.Content(title), Prop.Label(title), Prop.Checked(open), Prop.Expanded(open), Prop.Role("button"), Prop.Toggle(message)]);
    let mut content: List<View<M>> = [];
    if (open) { content = children; }
    let disclosure: View<M> = group(key + "-content", Kind.Column, [Prop.Role("group"), Prop.Disclosure(open)], content);
    let mut surfaceProps: List<Prop<M>> = [Prop.WidthPercent(100), Prop.MaxWidth(560)];
    for (prop in props) { surfaceProps = append(surfaceProps, prop); }
    group(key, Kind.Collapsible, surfaceProps, [trigger, disclosure])
}

export fn collapsible<M>(key: string, title: string, open: bool, message: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { collapsibleComponent(key, title, open, message, props, children) }
