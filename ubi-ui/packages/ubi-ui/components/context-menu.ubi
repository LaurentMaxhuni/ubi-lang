import { View, Kind, Prop, MenuAction, OverlayKind, node, group } from "../core.ubi";

export fn contextMenuComponent<M>(key: string, anchor: string, label: string, actions: List<MenuAction<M>>, open: bool, request: M, dismiss: M, props: List<Prop<M>>) -> View<M> {
    let mut items: List<View<M>> = [];
    for (action in actions) { items = append(items, node(key + "-item-" + action.value, Kind.MenuItem, [Prop.Label(action.label), Prop.Content(action.label), Prop.Option(action.value), Prop.Disabled(action.disabled), Prop.Activate(action.message), Prop.Role("menuitem")])); }
    group(key, Kind.Overlay, append(append(append(append(append(append(props, Prop.Label(label)), Prop.OverlayKind(OverlayKind.ContextMenu)), Prop.Anchor(anchor)), Prop.Open(open)), Prop.OpenRequest(request)), Prop.Dismiss(dismiss)), items)
}
export fn contextMenu<M>(key: string, anchor: string, label: string, actions: List<MenuAction<M>>, open: bool, request: M, dismiss: M, props: List<Prop<M>>) -> View<M> { contextMenuComponent(key, anchor, label, actions, open, request, dismiss, props) }
