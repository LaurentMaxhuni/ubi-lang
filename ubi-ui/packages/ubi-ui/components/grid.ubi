import { View, Kind, Prop, group } from "../core.ubi";

export fn gridComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.Grid, props, children)
}

export fn grid<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { gridComponent(key, props, children) }
