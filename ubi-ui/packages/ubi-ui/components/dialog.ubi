import { View, Prop, OverlayKind } from "../core.ubi";
import { overlayComponent } from "./overlay.ubi";

export fn dialogComponent<M>(key: string, label: string, open: bool, dismiss: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    overlayComponent(key, label, OverlayKind.Dialog, open, dismiss, props, children)
}
export fn dialog<M>(key: string, label: string, open: bool, dismiss: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { dialogComponent(key, label, open, dismiss, props, children) }
