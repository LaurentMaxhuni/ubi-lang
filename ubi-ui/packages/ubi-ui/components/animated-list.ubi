import { View, Kind, Prop, Effect, group } from "../core.ubi";

export fn animatedListComponent<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    group(key, Kind.EffectSurface, append(props, Prop.Effect(Effect.AnimatedList)), children)
}

export fn animatedList<M>(key: string, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { animatedListComponent(key, props, children) }
