import { View, Prop, OverlayKind } from "../core.ubi";
import { overlayComponent } from "./overlay.ubi";

export fn popoverComponent<M>(key: string, label: string, open: bool, dismiss: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    overlayComponent(key, label, OverlayKind.Popover, open, dismiss, props, children)
}
export fn popover<M>(key: string, label: string, open: bool, dismiss: M, props: List<Prop<M>>, children: List<View<M>>) -> View<M> { popoverComponent(key, label, open, dismiss, props, children) }
