// Schema 1 matches Ubi's source-owned keyed View ABI.
export enum Kind {
    Window, View, Column, Row, Flex, Grid, ScrollView, Card, Text, Heading,
    Separator, Button, IconButton, Checkbox, Switch, Slider, TextInput,
    PasswordInput, Badge, ProgressBar
}
export enum Space { None, Xs, Sm, Md, Lg, Xl, Xxl }
export enum Tone { Neutral, Primary, Success, Warning, Danger }
export enum ButtonVariant { Primary, Secondary, Outline, Ghost, Destructive }
export enum Theme { Light, Dark, System }
export enum Prop<M> {
    Content(string), Label(string), Value(string), Level(int), Gap(Space),
    Tone(Tone), Variant(ButtonVariant), Disabled(bool), Busy(bool), Pressed(bool),
    Checked(bool), Theme(Theme), Activate(M), Input(M), Toggle(M), Change(M),
    Width(int), Height(int), WidthPercent(int), HeightPercent(int), MinWidth(int),
    MinHeight(int), MaxWidth(int), MaxHeight(int), Padding(int), Grow(int),
    Columns(int), FontSize(int), Center(bool), Clip(bool), Absolute(int, int),
    Progress(int)
}
export record Node<M> {
    key: string, kind: Kind, props: List<Prop<M>>, children: List<string>
}
export record View<M> { schemaVersion: int, root: string, nodes: List<Node<M>> }
export enum Event<M> { Activate(M), Input(M, string), Toggle(M, bool), Select(M, string), Submit(M) }

export fn node<M>(key: string, kind: Kind, props: List<Prop<M>>) -> View<M> {
    View { schemaVersion: 1, root: key, nodes: [Node { key: key, kind: kind, props: props, children: [] }] }
}
export fn group<M>(key: string, kind: Kind, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    let mut keys: List<string> = [];
    for (child in children) { keys = append(keys, child.root); }
    let mut nodes = [Node { key: key, kind: kind, props: props, children: keys }];
    for (child in children) { for (item in child.nodes) { nodes = append(nodes, item); } }
    View { schemaVersion: 1, root: key, nodes: nodes }
}
