// Schema 1 matches Ubi's source-owned keyed View ABI.
export enum Kind {
    Window, View, Column, Row, Flex, Grid, ScrollView, Card, Text, Heading,
    Separator, Button, IconButton, Checkbox, Switch, Slider, TextInput,
    PasswordInput, Badge, ProgressBar, Radio, Tab, Toggle, ToggleItem, Link,
    TextArea, NumberInput, Avatar, Alert, Kbd, Skeleton, Label, Overlay,
    MenuItem, OptionItem, EffectSurface, Pagination, Table, TableRow,
    TableHeader, TableCell
}
export enum Easing { Linear, EaseOut, EaseInOut, Spring }
export enum Transition { None, Fade, Rise, Scale }
export enum OverlayKind {
    Dialog, AlertDialog, Drawer, Popover, Tooltip, Toast,
    Select, Combobox, DropdownMenu, ContextMenu, CommandPalette
}
export enum Placement { Top, Right, Bottom, Left, Center }
export enum Effect {
    NumberTicker, TextReveal, AnimatedList, Shimmer, SpotlightCard, TiltCard,
    CardStack, Carousel, Dock, Marquee, RotatingText, BorderBeam,
    AuroraBackground, GridBackground, ScrollReveal
}
export enum Space { None, Xs, Sm, Md, Lg, Xl, Xxl }
export enum Tone { Neutral, Primary, Success, Warning, Danger }
export enum ButtonVariant { Primary, Secondary, Outline, Ghost, Destructive }
export enum Theme { Light, Dark, System }
export enum Prop<M> {
    Content(string), Label(string), Value(string), Level(int), Gap(Space),
    Tone(Tone), Variant(ButtonVariant), Disabled(bool), Busy(bool), Pressed(bool),
    Checked(bool), Theme(Theme), Activate(M), Input(M), Toggle(M), Change(M),
    Width(int), Height(int), WidthPercent(int), HeightPercent(int), MinWidth(int),
    MinHeight(int), MaxWidth(int), MaxHeight(int), Padding(int), Grow(int),
    Columns(int), FontSize(int), Center(bool), Clip(bool), Absolute(int, int),
    Progress(int), Selected(bool), Option(string), Group(string), Min(int),
    Max(int), Step(int), ReadOnly(bool), Role(string), Expanded(bool),
    Motion(Motion), Enter(Transition), Exit(Transition), Opacity(int),
    Translate(int, int), Scale(int), Disclosure(bool), Page(int), PageCount(int),
    Effect(Effect), Number(int), Index(int), AutoPlay(bool), PeriodMs(int),
    Paused(bool), Advance(M), OverlayKind(OverlayKind), Open(bool), Anchor(string),
    Placement(Placement), Dismiss(M), TimeoutMs(int), LabelledBy(string),
    DescribedBy(string), OpenRequest(M)
}
export record Choice { value: string, label: string, disabled: bool }
export record Motion { durationMs: int, delayMs: int, easing: Easing }
export record MenuAction<M> { value: string, label: string, message: M, disabled: bool }
export record TableColumn { key: string, label: string, sortable: bool }
export record TableRow { key: string, cells: List<string> }
export record Node<M> {
    key: string, kind: Kind, props: List<Prop<M>>, children: List<string>
}
export record View<M> { schemaVersion: int, root: string, nodes: List<Node<M>> }
export enum Event<M> { Activate(M), Input(M, string), Toggle(M, bool), Select(M, string), Submit(M) }

export fn node<M>(key: string, kind: Kind, props: List<Prop<M>>) -> View<M> {
    View { schemaVersion: 1, root: key, nodes: [Node { key: key, kind: kind, props: props, children: [] }] }
}
export fn group<M>(key: string, kind: Kind, props: List<Prop<M>>, children: List<View<M>>) -> View<M> {
    let mut keys: List<string> = [];
    for (child in children) { keys = append(keys, child.root); }
    let mut nodes = [Node { key: key, kind: kind, props: props, children: keys }];
    for (child in children) { for (item in child.nodes) { nodes = append(nodes, item); } }
    View { schemaVersion: 1, root: key, nodes: nodes }
}
