import { View, Event, Prop, Space, ButtonVariant } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { toast } from "../../packages/ubi-ui/components/toast.ubi";

export enum Message { Show, Dismiss }
export fn init() -> bool { false }
export fn update(model: bool, event: Event<Message>) -> bool { match (event) { Event.Activate(Message.Show) => true, Event.Activate(Message.Dismiss) => false, _ => model } }
export fn view(model: bool) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Toast", 1),
        buttonComponent("show", "Save changes", Message.Show, []),
        toast("saved", "Changes saved", model, Message.Dismiss, [Prop.TimeoutMs(5000)], [textComponent("message", "Your workspace is up to date."), buttonComponent("close", "Dismiss notification", Message.Dismiss, [Prop.Variant(ButtonVariant.Ghost)])])
    ])
}
