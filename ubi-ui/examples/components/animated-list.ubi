import { View, Event, Prop, Space } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { rowComponent } from "../../packages/ubi-ui/components/row.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { animatedList } from "../../packages/ubi-ui/components/animated-list.ubi";

export enum Message { Reorder }
export fn init() -> bool { false }
export fn update(model: bool, event: Event<Message>) -> bool { match (event) { Event.Activate(Message.Reorder) => !model, _ => model } }
export fn view(model: bool) -> View<Message> {
    let first: View<Message> = textComponent("first", if (model) { "Second item" } else { "First item" });
    let second: View<Message> = textComponent("second", if (model) { "First item" } else { "Second item" });
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Animated List", 1),
        animatedList("items", [], if (model) { [second, first] } else { [first, second] }),
        rowComponent("controls", [Prop.Gap(Space.Sm)], [buttonComponent("reorder", "Reverse order", Message.Reorder, [])])
    ])
}
