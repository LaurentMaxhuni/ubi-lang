import { View, Event, Prop, Space } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { alertDialog } from "../../packages/ubi-ui/components/alert-dialog.ubi";

export record Model { open: bool, confirmed: bool }
export enum Message { Open, Cancel, Confirm }
export fn init() -> Model { Model { open: false, confirmed: false } }
export fn update(model: Model, event: Event<Message>) -> Model {
    match (event) {
        Event.Activate(Message.Open) => Model { ...model, open: true },
        Event.Activate(Message.Cancel) => Model { ...model, open: false },
        Event.Activate(Message.Confirm) => Model { ...model, open: false, confirmed: true },
        _ => model
    }
}
export fn view(model: Model) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Alert Dialog", 1),
        textComponent("status", if (model.confirmed) { "Project deletion confirmed." } else { "No changes made." }),
        buttonComponent("open", "Delete project…", Message.Open, []),
        alertDialog("confirm", "Delete project", model.open, Message.Cancel, [], [
            textComponent("warning", "This action removes the project from the workspace."),
            buttonComponent("cancel", "Keep project", Message.Cancel, []),
            buttonComponent("confirm-delete", "Delete project", Message.Confirm, [])
        ])
    ])
}
