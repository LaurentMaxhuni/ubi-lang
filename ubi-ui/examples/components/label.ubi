import { View, Event, Prop, Space } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { columnComponent } from "../../packages/ubi-ui/components/column.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { textInputComponent } from "../../packages/ubi-ui/components/input.ubi";
import { label } from "../../packages/ubi-ui/components/label.ubi";

export enum Message { Action, Toggle, Input, Select }
export fn init() -> int { 0 }
export fn update(model: int, event: Event<Message>) -> int {
    match (event) { Event.Activate(Message.Action) => model + 1, _ => model }
}
export fn view(model: int) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Lg)], [
        headingComponent("title", "Label", 1),
        textComponent("description", "Visible native label; pass the accessible label to its control too."),
        columnComponent("demo-field", [Prop.Gap(Space.Sm)], [label("demo", "Workspace name", []), textInputComponent("name", "Workspace name", "Orbit", Message.Input, [Prop.ReadOnly(true)])])
    ])
}
