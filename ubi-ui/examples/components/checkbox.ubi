import { View, Event, Prop, Space } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { checkbox } from "../../packages/ubi-ui/components/checkbox.ubi";

export enum Message { Action, Toggle, Input, Select }
export fn init() -> bool { false }
export fn update(model: bool, event: Event<Message>) -> bool {
    match (event) { Event.Toggle(Message.Toggle, value) => value, _ => model }
}
export fn view(model: bool) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Lg)], [
        headingComponent("title", "Checkbox", 1),
        textComponent("description", "Controlled checkbox dispatching Toggle messages."),
        checkbox("demo", "Accept notifications", model, Message.Toggle, [])
    ])
}
