import { View, Event, Prop, Space, MenuAction } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { contextMenu } from "../../packages/ubi-ui/components/context-menu.ubi";

export record Model { open: bool, action: string }
export enum Message { Request, Dismiss, Copy, Pin }
export fn init() -> Model { Model { open: false, action: "Right-click the project or press Shift+F10." } }
export fn update(model: Model, event: Event<Message>) -> Model {
    match (event) {
        Event.Activate(Message.Request) => Model { ...model, open: true },
        Event.Activate(Message.Dismiss) => Model { ...model, open: false },
        Event.Activate(Message.Copy) => Model { open: false, action: "Project link copied." },
        Event.Activate(Message.Pin) => Model { open: false, action: "Project pinned." },
        _ => model
    }
}
export fn view(model: Model) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Context Menu", 1),
        buttonComponent("project", "Design system", Message.Request, []),
        contextMenu("project-menu", "project", "Project actions", [MenuAction { value: "copy", label: "Copy link", message: Message.Copy, disabled: false }, MenuAction { value: "pin", label: "Pin to sidebar", message: Message.Pin, disabled: false }], model.open, Message.Request, Message.Dismiss, []),
        textComponent("status", model.action)
    ])
}
