import { View, Event, Prop, Space, MenuAction } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { commandPalette } from "../../packages/ubi-ui/components/command-palette.ubi";

export record Model { open: bool, query: string, action: string }
export enum Message { Open, Dismiss, Input, Settings, Help }
export fn init() -> Model { Model { open: false, query: "", action: "No command selected" } }
export fn update(model: Model, event: Event<Message>) -> Model {
    match (event) {
        Event.Activate(Message.Open) => Model { ...model, open: true },
        Event.Activate(Message.Dismiss) => Model { ...model, open: false },
        Event.Input(Message.Input, value) => Model { ...model, query: value },
        Event.Activate(Message.Settings) => Model { open: false, query: "", action: "Settings opened" },
        Event.Activate(Message.Help) => Model { open: false, query: "", action: "Help opened" },
        _ => model
    }
}
export fn view(model: Model) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Command Palette", 1),
        buttonComponent("launch", "Search commands", Message.Open, []),
        commandPalette("commands", "Command palette", [MenuAction { value: "settings", label: "Open settings", message: Message.Settings, disabled: false }, MenuAction { value: "help", label: "Get help", message: Message.Help, disabled: false }], model.query, model.open, Message.Input, Message.Dismiss, []),
        textComponent("status", model.action)
    ])
}
