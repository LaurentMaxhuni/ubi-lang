import { View, Event, Prop, Space, Placement } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { popover } from "../../packages/ubi-ui/components/popover.ubi";

export enum Message { Open, Close }
export fn init() -> bool { false }
export fn update(model: bool, event: Event<Message>) -> bool { match (event) { Event.Activate(Message.Open) => true, Event.Activate(Message.Close) => false, _ => model } }
export fn view(model: bool) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Popover", 1),
        buttonComponent("trigger", "Choose a date", Message.Open, [Prop.Expanded(model)]),
        popover("calendar", "Choose date", model, Message.Close, [Prop.Anchor("trigger"), Prop.Placement(Placement.Bottom)], [textComponent("date", "October 22"), buttonComponent("close", "Close date picker", Message.Close, [])])
    ])
}
