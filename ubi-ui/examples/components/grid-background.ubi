import { View, Event, Prop, Space } from "../../packages/ubi-ui/core.ubi";
import { windowComponent } from "../../packages/ubi-ui/components/window.ubi";
import { headingComponent } from "../../packages/ubi-ui/components/heading.ubi";
import { textComponent } from "../../packages/ubi-ui/components/text.ubi";
import { buttonComponent } from "../../packages/ubi-ui/components/button.ubi";
import { gridBackground } from "../../packages/ubi-ui/components/grid-background.ubi";

export enum Message { Add }
export fn init() -> int { 0 }
export fn update(model: int, event: Event<Message>) -> int { match (event) { Event.Activate(Message.Add) => model + 1, _ => model } }
export fn view(model: int) -> View<Message> {
    windowComponent("app", [Prop.Padding(32), Prop.Gap(Space.Md)], [
        headingComponent("title", "Grid Background", 1),
        gridBackground("canvas", [Prop.Padding(24), Prop.Height(220)], [headingComponent("grid-title", "Plan the next release", 2), textComponent("grid-copy", "The optional highlight stays inside this surface."), buttonComponent("add", "Add a milestone", Message.Add, [])]),
        textComponent("milestones", "Milestones added: " + toString(model))
    ])
}
